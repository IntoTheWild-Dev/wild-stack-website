# Xendit — get keys from https://dashboard.xendit.co/settings/developers#api-keys
# Use Development keys while testing; switch to Live for production.

XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override redirect URLs (must be absolute HTTPS URLs in production)
# XENDIT_SUCCESS_URL=https://your-domain.com/checkout-success.html
# XENDIT_FAILURE_URL=https://your-domain.com/checkout-failure.html

# Optional: public site origin if the API cannot infer the host (some proxies)
# PUBLIC_SITE_URL=https://your-domain.com
